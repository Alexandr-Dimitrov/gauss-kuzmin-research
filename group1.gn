     'speed_data/cbrt2_continued_10000.dat'    using 1 with lines lw 1.5 title '∛2', \
     'speed_data/zeta3_continued_10000.dat'    using 1 with lines lw 1.5 title 'ζ(3)', \
     'speed_data/ln2_continued_10000.dat'      using 1 with lines lw 1.5 title 'ln(2)'

set output