set terminal pngcairo size 900,600
set output './plots/histogram.png'

set style fill solid 0.5 border lt -1
set xlabel 'Число'
set ylabel 'Частота'
set title 'Статистика Гаусса-Кузьмина для числа Пи [100; 9900]'

plot 'distribution.dat' every ::0::15 using 1:2 with boxes title 'Наблюдаемое' lc rgb 'blue', \
     '' every ::0::15 using 1:3 with lines title 'Гаусс-Кузьмин' lc rgb 'red' lw 2

set output